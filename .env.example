# API prefix; no credentials. Same origin by default.
VITE_API_BASE_URL=/b2b

# Demo accounts, catalog and cart without PHP. Set true in .env.local to enable.
VITE_DEMO_MODE=false

# Optional dev proxy to an already running backend (keeps the /b2b path).
# This does not start PHP or connect a database.
# API_PROXY_TARGET=http://127.0.0.1:8000
